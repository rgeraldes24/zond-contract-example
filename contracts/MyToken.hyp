pragma hyperion ^0.0.2;

import "SQRCTF1.hyp";

contract MyToken is SQRCTF1 {
    constructor(string memory name, string memory symbol) SQRCTF1(name, symbol) {
        // Mint 100 tokens to msg.sender
        // Similar to how
        // 1 dollar = 100 cents
        // 1 token = 1 * (10 ** decimals)
        mint(100 * 10**uint(decimals));
    }
}
